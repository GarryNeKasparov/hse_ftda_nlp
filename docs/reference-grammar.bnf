# Version 1: a CFG over manually annotated, normalized tokens.
# This describes a reference candidate, not arbitrary surrounding prose.
# IDs are opaque labels: 1.3-3, а.1 and superscript suffixes stay atomic.
# RANGE means an already identified range operator, not any raw hyphen.
# PP is the abbreviation for a subpoint (подпункт).
# SELF_* tokens retain self references without inventing a numeric label.
# Target tokens retain explicit/self/anaphoric law mentions, not resolved IDs.
# EPS denotes the empty production.

start ::= reference reference_tail
reference_tail ::= join reference reference_tail | EPS
reference ::= branches target_optional
target_optional ::= LAW target_optional | SELF_LAW target_optional | ANAPHORIC_LAW target_optional | SELF_ARTICLE target_optional | ANAPHORIC_ARTICLE target_optional | EPS
branches ::= provision branch_tail
branch_tail ::= join provision branch_tail | EPS
provision ::= article_group | part_group | point_group | subpoint_group | paragraph_group

# Each group ends in its highest explicitly stated level. Lower levels
# may be omitted, combined in one path, or coordinated beneath a tail.
# No invisible levels or values are inserted by the grammar.
article_group ::= article_level | article_children level_gap article_level
article_children ::= article_child article_children_tail
article_children_tail ::= join article_child article_children_tail | EPS
article_child ::= part_group | point_group | subpoint_group | paragraph_group

part_group ::= part_level | part_children level_gap part_level
part_children ::= part_child part_children_tail
part_children_tail ::= join part_child part_children_tail | EPS
part_child ::= point_group | subpoint_group | paragraph_group

point_group ::= point_level | point_children level_gap point_level
point_children ::= point_child point_children_tail
point_children_tail ::= join point_child point_children_tail | EPS
point_child ::= subpoint_group | paragraph_group

subpoint_group ::= subpoint_level | subpoint_children level_gap subpoint_level
subpoint_children ::= paragraph_group subpoint_children_tail
subpoint_children_tail ::= join paragraph_group subpoint_children_tail | EPS
paragraph_group ::= paragraph_level

article_level ::= ARTICLE selector | SELF_ARTICLE
part_level ::= PART selector | SELF_PART
point_level ::= POINT selector | SELF_POINT
subpoint_level ::= SUBPOINT selector | PP selector | SELF_SUBPOINT
paragraph_level ::= PARAGRAPH selector | SELF_PARAGRAPH

selector ::= item selector_tail
selector_tail ::= join item selector_tail | EPS
item ::= identifier range_optional
identifier ::= ID | ORDINAL
range_optional ::= RANGE identifier | EPS

# A conjunction coordinates selectors or branches. It is not a generic
# link between nested levels. A comma can coordinate or bridge levels.
join ::= AND | OR | AND_OR | COMMA comma_join_tail
comma_join_tail ::= AND | OR | AND_OR | EPS
level_gap ::= COMMA gap_in_optional | IN | EPS
gap_in_optional ::= IN | EPS
